# ── Roma Backend Environment Configuration ─────────────────────────────────
# Copy this file to .env and adjust values for your environment.

# ASP.NET Core Runtime Environment
# Options: Development | Staging | Production
# In Development: detailed error traces and Swagger UI are enabled by default.
# In Production: error responses are sanitized (RFC 7807), and Swagger is disabled by default.
ASPNETCORE_ENVIRONMENT=Production

# OpenAPI / Swagger Documentation
# true: force-enable Swagger UI at /swagger
# false: force-disable Swagger UI (recommended in Production if exposed publicly)
# (empty / omitted): defaults to true in Development, false in Production
SWAGGER_ENABLED=false

# Cross-Origin Resource Sharing (CORS)
# Use comma-separated origins for production (e.g. https://roma.example.com,https://app.example.com)
# When explicit origins are set, Access-Control-Allow-Credentials is also supported.
# Use '*' to allow any origin (wildcard without credentials).
CORS_ORIGINS=https://your-frontend-domain.com

# Timezone (IANA Timezone ID)
# Used for daily rollups, reminders, and End-of-Day scheduling.
APP_TZ=America/Argentina/Buenos_Aires

# End-of-Day closing time (HH:mm in 24h format)
EOD_TIME=23:55

# Default Category list (comma-separated, initialized if DB has no categories)
CATEGORIES=Trabajo,Estudio,Salud,Personal,Hogar,Otros

# SQLite Database Storage
# Local dev: ./data/roma.db
# Dokploy / Docker: /app/data/roma.db (mounted to a persistent volume)
DB_PATH=/app/data/roma.db

# Notifications via Telegram Bot (Optional)
NOTIFY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reminder offsets for scheduled events (comma-separated intervals)
# Example: -7d (7 days before), -3d (3 days before), -1d (1 day before), -2h (2 hours before), 0 (at event start)
EVENT_REMINDER_OFFSETS=-7d,-3d,-1d,-2h,0
